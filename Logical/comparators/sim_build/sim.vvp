#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x55ea3bcb5d90 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x55ea3bcb5f20 .scope module, "comparator" "comparator" 3 1;
 .timescale -9 -12;
    .port_info 0 /INPUT 8 "a";
    .port_info 1 /INPUT 8 "b";
    .port_info 2 /OUTPUT 1 "equal";
    .port_info 3 /OUTPUT 1 "greater";
    .port_info 4 /OUTPUT 1 "less";
o0x7f42ff476018 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x55ea3bcdc5d0_0 .net "a", 7 0, o0x7f42ff476018;  0 drivers
o0x7f42ff476048 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x55ea3bcfe240_0 .net "b", 7 0, o0x7f42ff476048;  0 drivers
v0x55ea3bcfe320_0 .net "equal", 0 0, L_0x55ea3bcfe630;  1 drivers
v0x55ea3bcfe3c0_0 .net "greater", 0 0, L_0x55ea3bcfe730;  1 drivers
v0x55ea3bcfe480_0 .net "less", 0 0, L_0x55ea3bcfe8a0;  1 drivers
L_0x55ea3bcfe630 .cmp/eq 8, o0x7f42ff476018, o0x7f42ff476048;
L_0x55ea3bcfe730 .cmp/gt 8, o0x7f42ff476018, o0x7f42ff476048;
L_0x55ea3bcfe8a0 .cmp/gt 8, o0x7f42ff476048, o0x7f42ff476018;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "/home/mirafra/vlsi/Logical/comparators/comparator.sv";
