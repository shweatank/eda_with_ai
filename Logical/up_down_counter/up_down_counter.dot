digraph "up_down_counter" {
label="up_down_counter";
rankdir="LR";
remincross=true;
n4 [ shape=octagon, label="clk", color="black", fontcolor="black" ];
n5 [ shape=octagon, label="count", color="black", fontcolor="black" ];
n6 [ shape=octagon, label="reset", color="black", fontcolor="black" ];
n7 [ shape=octagon, label="up", color="black", fontcolor="black" ];
v0 [ label="1'1" ];
c11 [ shape=record, label="{{<p8> A|<p9> B}|$2\n$add|{<p10> Y}}" ];
c16 [ shape=record, label="{{<p12> ARST|<p13> CLK|<p14> D}|$7\n$adff|{<p15> Q}}" ];
c18 [ shape=record, label="{{<p8> A|<p9> B|<p17> S}|$5\n$mux|{<p10> Y}}" ];
v1 [ label="1'1" ];
c19 [ shape=record, label="{{<p8> A|<p9> B}|$3\n$sub|{<p10> Y}}" ];
c18:p10:e -> c16:p14:w [color="black", style="setlinewidth(3)", label=""];
c11:p10:e -> c18:p9:w [color="black", style="setlinewidth(3)", label=""];
c19:p10:e -> c18:p8:w [color="black", style="setlinewidth(3)", label=""];
n4:e -> c16:p13:w [color="black", label=""];
c16:p15:e -> n5:w [color="black", style="setlinewidth(3)", label=""];
n5:e -> c11:p8:w [color="black", style="setlinewidth(3)", label=""];
n5:e -> c19:p8:w [color="black", style="setlinewidth(3)", label=""];
n6:e -> c16:p12:w [color="black", label=""];
n7:e -> c18:p17:w [color="black", label=""];
v0:e -> c11:p9:w [color="black", label=""];
v1:e -> c19:p9:w [color="black", label=""];
}
