:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5561e8fd2050 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5561e8fd21e0 .scope module, "waveform_tb" "waveform_tb" 3 3;
 .timescale -9 -12;
v0x5561e8fe4f00_0 .var "clk", 0 0;
v0x5561e8fe4fc0_0 .net "count", 7 0, v0x5561e8fe4be0_0;  1 drivers
v0x5561e8fe5090_0 .var "reset", 0 0;
v0x5561e8fe5190_0 .var "up", 0 0;
S_0x5561e8fbfce0 .scope module, "dut" "up_down_counter" 3 9, 4 1 0, S_0x5561e8fd21e0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "reset";
    .port_info 2 /INPUT 1 "up";
    .port_info 3 /OUTPUT 8 "count";
v0x5561e8f99ba0_0 .net "clk", 0 0, v0x5561e8fe4f00_0;  1 drivers
v0x5561e8fe4be0_0 .var "count", 7 0;
v0x5561e8fe4cc0_0 .net "reset", 0 0, v0x5561e8fe5090_0;  1 drivers
v0x5561e8fe4d90_0 .net "up", 0 0, v0x5561e8fe5190_0;  1 drivers
E_0x5561e8f98410 .event posedge, v0x5561e8fe4cc0_0, v0x5561e8f99ba0_0;
    .scope S_0x5561e8fbfce0;
T_0 ;
    %wait E_0x5561e8f98410;
    %load/vec4 v0x5561e8fe4cc0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 8;
    %assign/vec4 v0x5561e8fe4be0_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x5561e8fe4d90_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.2, 8;
    %load/vec4 v0x5561e8fe4be0_0;
    %addi 1, 0, 8;
    %assign/vec4 v0x5561e8fe4be0_0, 0;
    %jmp T_0.3;
T_0.2 ;
    %load/vec4 v0x5561e8fe4be0_0;
    %subi 1, 0, 8;
    %assign/vec4 v0x5561e8fe4be0_0, 0;
T_0.3 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x5561e8fd21e0;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5561e8fe4f00_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5561e8fe5090_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5561e8fe5190_0, 0, 1;
    %end;
    .thread T_1, $init;
    .scope S_0x5561e8fd21e0;
T_2 ;
    %delay 5000, 0;
    %load/vec4 v0x5561e8fe4f00_0;
    %inv;
    %store/vec4 v0x5561e8fe4f00_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x5561e8fd21e0;
T_3 ;
    %vpi_call/w 3 19 "$dumpfile", "up_down_counter.vcd" {0 0 0};
    %vpi_call/w 3 20 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5561e8fd21e0 {0 0 0};
    %delay 12000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5561e8fe5090_0, 0, 1;
    %delay 30000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5561e8fe5190_0, 0, 1;
    %delay 30000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5561e8fe5190_0, 0, 1;
    %delay 20000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5561e8fe5090_0, 0, 1;
    %delay 8000, 0;
    %vpi_call/w 3 25 "$finish" {0 0 0};
    %end;
    .thread T_3;
