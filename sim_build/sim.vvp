#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5653e02ac090 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x5653e0286dc0 .scope module, "xor_gate" "xor_gate" 3 1;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
o0x7fc8bdeb8018 .functor BUFZ 1, C4<z>; HiZ drive
o0x7fc8bdeb8048 .functor BUFZ 1, C4<z>; HiZ drive
L_0x5653e02ce4f0 .functor XOR 1, o0x7fc8bdeb8018, o0x7fc8bdeb8048, C4<0>, C4<0>;
v0x5653e0298bd0_0 .net "a", 0 0, o0x7fc8bdeb8018;  0 drivers
v0x5653e02ce310_0 .net "b", 0 0, o0x7fc8bdeb8048;  0 drivers
v0x5653e02ce3d0_0 .net "y", 0 0, L_0x5653e02ce4f0;  1 drivers
    .scope S_0x5653e0286dc0;
T_0 ;
    %vpi_call/w 3 9 "$dumpfile", "xor_gate.vcd" {0 0 0};
    %vpi_call/w 3 10 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5653e0286dc0 {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "/home/mirafra/vlsi/design_xor.sv";
