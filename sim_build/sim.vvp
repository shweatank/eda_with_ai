#! /opt/homebrew/Cellar/icarus-verilog/13.0/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/system.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_sys.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_textio.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2005_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/va_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2009.vpi";
S_0x10545fd90 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x105462580 .scope module, "dff_1bit" "dff_1bit" 3 178;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "reset";
    .port_info 2 /INPUT 1 "d";
    .port_info 3 /OUTPUT 1 "q";
o0x85d020010 .functor BUFZ 1, c4<z>; HiZ drive
v0x10545ff10_0 .net "clk", 0 0, o0x85d020010;  0 drivers
o0x85d020040 .functor BUFZ 1, c4<z>; HiZ drive
v0x105462700_0 .net "d", 0 0, o0x85d020040;  0 drivers
v0x1054627a0_0 .var "q", 0 0;
o0x85d0200a0 .functor BUFZ 1, c4<z>; HiZ drive
v0x10545dc50_0 .net "reset", 0 0, o0x85d0200a0;  0 drivers
E_0x85d434000 .event posedge, v0x10545dc50_0, v0x10545ff10_0;
    .scope S_0x105462580;
T_0 ;
    %wait E_0x85d434000;
    %load/vec4 v0x10545dc50_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x1054627a0_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x105462700_0;
    %assign/vec4 v0x1054627a0_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x105462580;
T_1 ;
    %vpi_call/w 3 195 "$dumpfile", "dff_waveform.vcd" {0 0 0};
    %vpi_call/w 3 196 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x105462580 {0 0 0};
    %end;
    .thread T_1;
