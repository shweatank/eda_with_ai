    .scope S_0x1056ebd20;
T_0 ;
    %vpi_call/w 3 9 "$dumpfile", "adder_logic.vcd" {0 0 0};
    %vpi_call/w 3 10 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x1056ebd20 {0 0 0};
