v0x6487f0f38fb0_0 .net "clk", 0 0, o0x7a49e13cf018;  0 drivers
v0x6487f0f5b240_0 .var "count", 7 0;
o0x7a49e13cf078 .functor BUFZ 1, C4<z>; HiZ drive
v0x6487f0f5b320_0 .net "reset", 0 0, o0x7a49e13cf078;  0 drivers
E_0x6487f0f12a30 .event posedge, v0x6487f0f5b320_0, v0x6487f0f38fb0_0;
    .scope S_0x6487f0f12700;
T_0 ;
    %wait E_0x6487f0f12a30;
    %load/vec4 v0x6487f0f5b320_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 8;
    %assign/vec4 v0x6487f0f5b240_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x6487f0f5b240_0;
    %addi 1, 0, 8;
    %assign/vec4 v0x6487f0f5b240_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x6487f0f12700;
T_1 ;
    %vpi_call/w 3 50 "$dumpfile", "waves/rtl.vcd" {0 0 0};
    %vpi_call/w 3 52 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x6487f0f12700 {0 0 0};
    %end;
    .thread T_1;
