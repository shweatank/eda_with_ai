 .timescale 0 0;
S_0x6487f0f12700 .scope module, "counter" "counter" 3 7;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "reset";
    .port_info 2 /OUTPUT 8 "count";
