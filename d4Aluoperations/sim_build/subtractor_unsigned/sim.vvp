:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x561332f05cf0 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x561332f05e80 .scope module, "subtractor_unsigned" "subtractor_unsigned" 3 24;
 .timescale -9 -12;
    .port_info 0 /INPUT 8 "A";
    .port_info 1 /INPUT 8 "B";
    .port_info 2 /OUTPUT 8 "y";
o0x7fe3c32b8018 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x561332f06060_0 .net "A", 7 0, o0x7fe3c32b8018;  0 drivers
o0x7fe3c32b8048 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x561332f5e2b0_0 .net "B", 7 0, o0x7fe3c32b8048;  0 drivers
v0x561332f5e390_0 .net "y", 7 0, L_0x561332f5e4d0;  1 drivers
L_0x561332f5e4d0 .arith/sub 8, o0x7fe3c32b8018, o0x7fe3c32b8048;
