#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x55e370c24d90 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x55e370c24f20 .scope module, "unsigned_div" "unsigned_div" 3 1;
 .timescale -9 -12;
    .port_info 0 /INPUT 8 "a";
    .port_info 1 /INPUT 8 "b";
    .port_info 2 /OUTPUT 8 "quotient";
    .port_info 3 /OUTPUT 8 "remainder";
o0x7fc73d2b8018 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x55e370c4b850_0 .net "a", 7 0, o0x7fc73d2b8018;  0 drivers
o0x7fc73d2b8048 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x55e370c6db10_0 .net "b", 7 0, o0x7fc73d2b8048;  0 drivers
v0x55e370c6dbf0_0 .net "quotient", 7 0, L_0x55e370c6de40;  1 drivers
v0x55e370c6dcb0_0 .net "remainder", 7 0, L_0x55e370c6df40;  1 drivers
L_0x55e370c6de40 .arith/div 8, o0x7fc73d2b8018, o0x7fc73d2b8048;
L_0x55e370c6df40 .arith/mod 8, o0x7fc73d2b8018, o0x7fc73d2b8048;
    .scope S_0x55e370c24f20;
T_0 ;
    %vpi_call/w 3 12 "$dumpfile", "dump_unsigned_div.vcd" {0 0 0};
    %vpi_call/w 3 13 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x55e370c24f20 {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "/home/mirafra/vlsi/Arithmetic/unsigned_div/unsigned_div.sv";
