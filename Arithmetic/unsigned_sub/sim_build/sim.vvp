#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x563fc5609d90 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x563fc5609f20 .scope module, "unsigned_sub" "unsigned_sub" 3 1;
 .timescale -9 -12;
    .port_info 0 /INPUT 8 "a";
    .port_info 1 /INPUT 8 "b";
    .port_info 2 /OUTPUT 8 "diff";
o0x7f19a0e75018 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x563fc561b7e0_0 .net "a", 7 0, o0x7f19a0e75018;  0 drivers
o0x7f19a0e75048 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x563fc561bbd0_0 .net "b", 7 0, o0x7f19a0e75048;  0 drivers
v0x563fc5652030_0 .net "diff", 7 0, L_0x563fc5652170;  1 drivers
L_0x563fc5652170 .arith/sub 8, o0x7f19a0e75018, o0x7f19a0e75048;
    .scope S_0x563fc5609f20;
T_0 ;
    %vpi_call/w 3 10 "$dumpfile", "dump_unsigned_sub.vcd" {0 0 0};
    %vpi_call/w 3 11 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x563fc5609f20 {0 0 0};
    %end;
    .thread T_0;
