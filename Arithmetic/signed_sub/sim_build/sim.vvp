#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x556d3a0c4d90 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x556d3a0c4f20 .scope module, "signed_sub" "signed_sub" 3 1;
 .timescale -9 -12;
    .port_info 0 /INPUT 8 "a";
    .port_info 1 /INPUT 8 "b";
    .port_info 2 /OUTPUT 9 "diff";
v0x556d3a0d67e0_0 .net/s *"_ivl_0", 8 0, L_0x556d3a10da00;  1 drivers
v0x556d3a0d6bd0_0 .net/s *"_ivl_2", 8 0, L_0x556d3a10dad0;  1 drivers
o0x7ff7b982e078 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x556d3a10d6b0_0 .net/s "a", 7 0, o0x7ff7b982e078;  0 drivers
o0x7ff7b982e0a8 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x556d3a10d770_0 .net/s "b", 7 0, o0x7ff7b982e0a8;  0 drivers
v0x556d3a10d850_0 .net/s "diff", 8 0, L_0x556d3a10dbd0;  1 drivers
L_0x556d3a10da00 .extend/s 9, o0x7ff7b982e078;
L_0x556d3a10dad0 .extend/s 9, o0x7ff7b982e0a8;
L_0x556d3a10dbd0 .arith/sub 9, L_0x556d3a10da00, L_0x556d3a10dad0;
    .scope S_0x556d3a0c4f20;
T_0 ;
    %vpi_call/w 3 10 "$dumpfile", "dump_signed_sub.vcd" {0 0 0};
    %vpi_call/w 3 11 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x556d3a0c4f20 {0 0 0};
    %end;
    .thread T_0;
