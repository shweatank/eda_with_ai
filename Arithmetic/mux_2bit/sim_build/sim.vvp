#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x55c9f8686d90 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x55c9f8686f20 .scope module, "mux_2bit" "mux_2bit" 3 1;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /INPUT 1 "sel";
    .port_info 3 /OUTPUT 1 "y";
o0x7f68d199f018 .functor BUFZ 1, C4<z>; HiZ drive
v0x55c9f8698bd0_0 .net "a", 0 0, o0x7f68d199f018;  0 drivers
o0x7f68d199f048 .functor BUFZ 1, C4<z>; HiZ drive
v0x55c9f86cdcc0_0 .net "b", 0 0, o0x7f68d199f048;  0 drivers
o0x7f68d199f078 .functor BUFZ 1, C4<z>; HiZ drive
v0x55c9f86cdd80_0 .net "sel", 0 0, o0x7f68d199f078;  0 drivers
v0x55c9f86cde50_0 .net "y", 0 0, L_0x55c9f86cdfc0;  1 drivers
L_0x55c9f86cdfc0 .functor MUXZ 1, o0x7f68d199f018, o0x7f68d199f048, o0x7f68d199f078, C4<>;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
