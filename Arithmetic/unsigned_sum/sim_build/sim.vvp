#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x56409fd27340 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x56409fd01dc0 .scope module, "sum_op" "sum_op" 3 1;
 .timescale -9 -12;
    .port_info 0 /INPUT 8 "a";
    .port_info 1 /INPUT 8 "b";
    .port_info 2 /OUTPUT 8 "sum";
o0x7f209b084018 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x56409fd137e0_0 .net "a", 0 7, o0x7f209b084018;  0 drivers
o0x7f209b084048 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x56409fd13bd0_0 .net "b", 0 7, o0x7f209b084048;  0 drivers
v0x56409fd49c50_0 .net "sum", 0 7, L_0x56409fd49d90;  1 drivers
L_0x56409fd49d90 .arith/sum 8, o0x7f209b084018, o0x7f209b084048;
    .scope S_0x56409fd01dc0;
T_0 ;
    %vpi_call/w 3 10 "$dumpfile", "dump_sum.vcd" {0 0 0};
    %vpi_call/w 3 11 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x56409fd01dc0 {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "/home/mirafra/vlsi/Arithmetic/sum/sum.sv";
