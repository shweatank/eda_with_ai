#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x55c341ea4df0 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x55c341ea4f80 .scope module, "counter" "counter" 3 1;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "reset";
    .port_info 2 /OUTPUT 8 "count";
P_0x55c341ea5110 .param/l "WIDTH" 0 3 2, +C4<00000000000000000000000000001000>;
o0x7f70a065e018 .functor BUFZ 1, C4<z>; HiZ drive
v0x55c341ecb520_0 .net "clk", 0 0, o0x7f70a065e018;  0 drivers
v0x55c341eeda90_0 .var "count", 7 0;
o0x7f70a065e078 .functor BUFZ 1, C4<z>; HiZ drive
v0x55c341eedb70_0 .net "reset", 0 0, o0x7f70a065e078;  0 drivers
E_0x55c341ede100 .event posedge, v0x55c341eedb70_0, v0x55c341ecb520_0;
    .scope S_0x55c341ea4f80;
T_0 ;
    %vpi_call/w 3 10 "$dumpfile", "counter.vcd" {0 0 0};
    %vpi_call/w 3 11 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x55c341ea4f80 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x55c341ea4f80;
T_1 ;
    %wait E_0x55c341ede100;
    %load/vec4 v0x55c341eedb70_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_1.0, 8;
    %pushi/vec4 0, 0, 8;
    %assign/vec4 v0x55c341eeda90_0, 0;
    %jmp T_1.1;
T_1.0 ;
    %load/vec4 v0x55c341eeda90_0;
    %addi 1, 0, 8;
    %assign/vec4 v0x55c341eeda90_0, 0;
T_1.1 ;
    %jmp T_1;
    .thread T_1;
