#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5a4b2dd4e0c0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5a4b2dd4e250 .scope module, "waveform_tb" "waveform_tb" 3 3;
 .timescale -9 -12;
v0x5a4b2dd63960_0 .var "address", 7 0;
v0x5a4b2dd63a40_0 .var "clk", 0 0;
v0x5a4b2dd63b10_0 .net "read_data", 7 0, v0x5a4b2dd635f0_0;  1 drivers
v0x5a4b2dd63c10_0 .var "write_data", 7 0;
v0x5a4b2dd63ce0_0 .var "write_enable", 0 0;
S_0x5a4b2dd12cf0 .scope module, "dut" "dynamic_ram" 3 10, 4 1 0, S_0x5a4b2dd4e250;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "write_enable";
    .port_info 2 /INPUT 8 "address";
    .port_info 3 /INPUT 8 "write_data";
    .port_info 4 /OUTPUT 8 "read_data";
P_0x5a4b2dd38780 .param/l "ADDRESS_WIDTH" 0 4 3, +C4<00000000000000000000000000001000>;
P_0x5a4b2dd387c0 .param/l "DATA_WIDTH" 0 4 2, +C4<00000000000000000000000000001000>;
v0x5a4b2dd12ff0_0 .net "address", 7 0, v0x5a4b2dd63960_0;  1 drivers
v0x5a4b2dd63460_0 .net "clk", 0 0, v0x5a4b2dd63a40_0;  1 drivers
v0x5a4b2dd63520 .array "memory", 255 0, 7 0;
v0x5a4b2dd635f0_0 .var "read_data", 7 0;
v0x5a4b2dd636d0_0 .net "write_data", 7 0, v0x5a4b2dd63c10_0;  1 drivers
v0x5a4b2dd63800_0 .net "write_enable", 0 0, v0x5a4b2dd63ce0_0;  1 drivers
E_0x5a4b2dd4c7c0 .event posedge, v0x5a4b2dd63460_0;
    .scope S_0x5a4b2dd12cf0;
T_0 ;
    %wait E_0x5a4b2dd4c7c0;
    %load/vec4 v0x5a4b2dd63800_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %load/vec4 v0x5a4b2dd636d0_0;
    %load/vec4 v0x5a4b2dd12ff0_0;
    %pad/u 10;
    %ix/vec4 3;
    %ix/load 4, 0, 0; Constant delay
    %assign/vec4/a/d v0x5a4b2dd63520, 0, 4;
T_0.0 ;
    %load/vec4 v0x5a4b2dd12ff0_0;
    %pad/u 10;
    %ix/vec4 4;
    %load/vec4a v0x5a4b2dd63520, 4;
    %assign/vec4 v0x5a4b2dd635f0_0, 0;
    %jmp T_0;
    .thread T_0;
    .scope S_0x5a4b2dd4e250;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a4b2dd63a40_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a4b2dd63ce0_0, 0, 1;
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x5a4b2dd63960_0, 0, 8;
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x5a4b2dd63c10_0, 0, 8;
    %end;
    .thread T_1, $init;
    .scope S_0x5a4b2dd4e250;
T_2 ;
    %delay 5000, 0;
    %load/vec4 v0x5a4b2dd63a40_0;
    %inv;
    %store/vec4 v0x5a4b2dd63a40_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x5a4b2dd4e250;
T_3 ;
    %vpi_call/w 3 21 "$dumpfile", "ram.vcd" {0 0 0};
    %vpi_call/w 3 22 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5a4b2dd4e250 {0 0 0};
    %delay 7000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a4b2dd63ce0_0, 0, 1;
    %pushi/vec4 16, 0, 8;
    %store/vec4 v0x5a4b2dd63960_0, 0, 8;
    %pushi/vec4 165, 0, 8;
    %store/vec4 v0x5a4b2dd63c10_0, 0, 8;
    %delay 10000, 0;
    %pushi/vec4 32, 0, 8;
    %store/vec4 v0x5a4b2dd63960_0, 0, 8;
    %pushi/vec4 90, 0, 8;
    %store/vec4 v0x5a4b2dd63c10_0, 0, 8;
    %delay 10000, 0;
    %pushi/vec4 255, 0, 8;
    %store/vec4 v0x5a4b2dd63960_0, 0, 8;
    %pushi/vec4 195, 0, 8;
    %store/vec4 v0x5a4b2dd63c10_0, 0, 8;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a4b2dd63ce0_0, 0, 1;
    %pushi/vec4 16, 0, 8;
    %store/vec4 v0x5a4b2dd63960_0, 0, 8;
    %delay 10000, 0;
    %pushi/vec4 32, 0, 8;
    %store/vec4 v0x5a4b2dd63960_0, 0, 8;
    %delay 10000, 0;
    %pushi/vec4 255, 0, 8;
    %store/vec4 v0x5a4b2dd63960_0, 0, 8;
    %delay 10000, 0;
    %vpi_call/w 3 29 "$finish" {0 0 0};
    %end;
    .thread T_3;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "waveform_tb.sv";
    "ram.sv";
