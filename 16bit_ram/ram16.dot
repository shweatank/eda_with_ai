digraph "simple_ram_16bit" {
label="simple_ram_16bit";
rankdir="LR";
remincross=true;
n8 [ shape=octagon, label="address", color="black", fontcolor="black" ];
n9 [ shape=octagon, label="clk", color="black", fontcolor="black" ];
n10 [ shape=octagon, label="read_data", color="black", fontcolor="black" ];
n11 [ shape=octagon, label="write_data", color="black", fontcolor="black" ];
n12 [ shape=octagon, label="write_enable", color="black", fontcolor="black" ];
v0 [ label="1'x" ];
v1 [ label="1'x" ];
c17 [ shape=record, label="{{<p13> ADDR|<p14> CLK|<p15> EN}|$6\n$memrd|{<p16> DATA}}" ];
v2 [ label="1'x" ];
c18 [ shape=record, label="{{<p13> ADDR|<p14> CLK|<p16> DATA|<p15> EN}|$7\n$memwr|{}}" ];
c21 [ shape=record, label="{{<p14> CLK|<p19> D}|$14\n$dff|{<p20> Q}}" ];
c22 [ shape=record, label="{{<p14> CLK|<p19> D}|$15\n$dff|{<p20> Q}}" ];
c23 [ shape=record, label="{{<p14> CLK|<p19> D}|$16\n$dff|{<p20> Q}}" ];
x3 [ shape=record, style=rounded, label="<s15> 16x 15:15 - 15:0 " ];
x3:e -> c23:p19:w [arrowhead=odiamond, arrowtail=odiamond, dir=both, color="black", style="setlinewidth(3)", label=""];
c24 [ shape=record, label="{{<p14> CLK|<p19> D}|$17\n$dff|{<p20> Q}}" ];
v4 [ label="16'xxxxxxxxxxxxxxxx" ];
c29 [ shape=record, label="{{<p25> A|<p26> B|<p27> S}|$10\n$mux|{<p28> Y}}" ];
v5 [ label="8'xxxxxxxx" ];
c30 [ shape=record, label="{{<p25> A|<p26> B|<p27> S}|$12\n$mux|{<p28> Y}}" ];
v6 [ label="1'0" ];
v7 [ label="1'1" ];
c31 [ shape=record, label="{{<p25> A|<p26> B|<p27> S}|$8\n$mux|{<p28> Y}}" ];
x8 [ shape=record, style=rounded, label="<s0> 0:0 - 15:15 " ];
c31:p28:e -> x8:w [arrowhead=odiamond, arrowtail=odiamond, dir=both, color="black", label=""];
x9 [ shape=record, style=rounded, label="<s14> 15x 15:15 - 14:0 " ];
x10 [ shape=record, style=rounded, label="<s0> 14:0 - 14:0 " ];
x9:e -> x10:w [arrowhead=odiamond, arrowtail=odiamond, dir=both, color="black", style="setlinewidth(3)", label=""];
c30:p28:e -> c21:p19:w [color="black", style="setlinewidth(3)", label=""];
c24:p20:e -> n10:w [color="black", style="setlinewidth(3)", label=""];
n11:e -> c29:p26:w [color="black", style="setlinewidth(3)", label=""];
n12:e -> c29:p27:w [color="black", label=""];
n12:e -> c30:p27:w [color="black", label=""];
n12:e -> c31:p27:w [color="black", label=""];
c29:p28:e -> c22:p19:w [color="black", style="setlinewidth(3)", label=""];
n3 [ shape=point ];
x10:s0:e -> n3:w [color="black", style="setlinewidth(3)", label=""];
x8:s0:e -> n3:w [color="black", style="setlinewidth(3)", label=""];
n3:e -> x3:s15:w [color="black", style="setlinewidth(3)", label=""];
n3:e -> x9:s14:w [color="black", style="setlinewidth(3)", label=""];
c17:p16:e -> c24:p19:w [color="black", style="setlinewidth(3)", label=""];
c21:p20:e -> c18:p13:w [color="black", style="setlinewidth(3)", label=""];
c22:p20:e -> c18:p16:w [color="black", style="setlinewidth(3)", label=""];
c23:p20:e -> c18:p15:w [color="black", style="setlinewidth(3)", label=""];
n8:e -> c17:p13:w [color="black", style="setlinewidth(3)", label=""];
n8:e -> c30:p26:w [color="black", style="setlinewidth(3)", label=""];
n9:e -> c21:p14:w [color="black", label=""];
n9:e -> c22:p14:w [color="black", label=""];
n9:e -> c23:p14:w [color="black", label=""];
n9:e -> c24:p14:w [color="black", label=""];
v0:e -> c17:p14:w [color="black", label=""];
v1:e -> c17:p15:w [color="black", label=""];
v2:e -> c18:p14:w [color="black", label=""];
v4:e -> c29:p25:w [color="black", style="setlinewidth(3)", label=""];
v5:e -> c30:p25:w [color="black", style="setlinewidth(3)", label=""];
v6:e -> c31:p25:w [color="black", label=""];
v7:e -> c31:p26:w [color="black", label=""];
}
