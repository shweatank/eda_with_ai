#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x61bbed750510 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x61bbed7506a0 .scope module, "comb_logic" "comb_logic" 3 1;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /INPUT 1 "c";
    .port_info 3 /OUTPUT 1 "y";
o0x75039cfcf048 .functor BUFZ 1, C4<z>; HiZ drive
o0x75039cfcf078 .functor BUFZ 1, C4<z>; HiZ drive
L_0x61bbed798960 .functor AND 1, o0x75039cfcf048, o0x75039cfcf078, C4<1>, C4<1>;
o0x75039cfcf0a8 .functor BUFZ 1, C4<z>; HiZ drive
L_0x61bbed798a50 .functor OR 1, L_0x61bbed798960, o0x75039cfcf0a8, C4<0>, C4<0>;
v0x61bbed776d50_0 .net *"_ivl_0", 0 0, L_0x61bbed798960;  1 drivers
v0x61bbed798580_0 .net "a", 0 0, o0x75039cfcf048;  0 drivers
v0x61bbed798640_0 .net "b", 0 0, o0x75039cfcf078;  0 drivers
v0x61bbed798710_0 .net "c", 0 0, o0x75039cfcf0a8;  0 drivers
v0x61bbed7987d0_0 .net "y", 0 0, L_0x61bbed798a50;  1 drivers
    .scope S_0x61bbed7506a0;
T_0 ;
    %vpi_call/w 3 10 "$dumpfile", "comb_logic.vcd" {0 0 0};
    %vpi_call/w 3 11 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x61bbed7506a0 {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "/home/sam/combinational_logic/comb_logic.sv";
