#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x63e7936f9850 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x63e7936d4570 .scope module, "dff_1bit" "dff_1bit" 3 1;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "d";
    .port_info 2 /OUTPUT 1 "q";
o0x7a1ddc2b7018 .functor BUFZ 1, C4<z>; HiZ drive
v0x63e7936d4770_0 .net "clk", 0 0, o0x7a1ddc2b7018;  0 drivers
o0x7a1ddc2b7048 .functor BUFZ 1, C4<z>; HiZ drive
v0x63e79371be70_0 .net "d", 0 0, o0x7a1ddc2b7048;  0 drivers
v0x63e79371bf30_0 .var "q", 0 0;
E_0x63e7936e86b0 .event posedge, v0x63e7936d4770_0;
    .scope S_0x63e7936d4570;
T_0 ;
    %wait E_0x63e7936e86b0;
    %load/vec4 v0x63e79371be70_0;
    %assign/vec4 v0x63e79371bf30_0, 0;
    %jmp T_0;
    .thread T_0;
    .scope S_0x63e7936d4570;
T_1 ;
    %vpi_call/w 3 12 "$dumpfile", "dff_1bit.vcd" {0 0 0};
    %vpi_call/w 3 13 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x63e7936d4570 {0 0 0};
    %end;
    .thread T_1;
