digraph "ram" {
label="ram";
rankdir="LR";
remincross=true;
n8 [ shape=octagon, label="clk", color="black", fontcolor="black" ];
n9 [ shape=octagon, label="read_address", color="black", fontcolor="black" ];
n10 [ shape=octagon, label="read_data", color="black", fontcolor="black" ];
n11 [ shape=octagon, label="write_address", color="black", fontcolor="black" ];
n12 [ shape=octagon, label="write_data", color="black", fontcolor="black" ];
n13 [ shape=octagon, label="write_enable", color="black", fontcolor="black" ];
v0 [ label="1'x" ];
v1 [ label="1'x" ];
c18 [ shape=record, label="{{<p14> ADDR|<p15> CLK|<p16> EN}|$6\n$memrd|{<p17> DATA}}" ];
v2 [ label="1'x" ];
c19 [ shape=record, label="{{<p14> ADDR|<p15> CLK|<p17> DATA|<p16> EN}|$7\n$memwr|{}}" ];
c22 [ shape=record, label="{{<p15> CLK|<p20> D}|$14\n$dff|{<p21> Q}}" ];
c23 [ shape=record, label="{{<p15> CLK|<p20> D}|$15\n$dff|{<p21> Q}}" ];
c24 [ shape=record, label="{{<p15> CLK|<p20> D}|$16\n$dff|{<p21> Q}}" ];
c25 [ shape=record, label="{{<p15> CLK|<p20> D}|$17\n$dff|{<p21> Q}}" ];
x3 [ shape=record, style=rounded, label="<s15> 16x 15:15 - 15:0 " ];
x3:e -> c25:p20:w [arrowhead=odiamond, arrowtail=odiamond, dir=both, color="black", style="setlinewidth(3)", label=""];
v4 [ label="16'xxxxxxxxxxxxxxxx" ];
c30 [ shape=record, label="{{<p26> A|<p27> B|<p28> S}|$10\n$mux|{<p29> Y}}" ];
v5 [ label="8'xxxxxxxx" ];
c31 [ shape=record, label="{{<p26> A|<p27> B|<p28> S}|$12\n$mux|{<p29> Y}}" ];
v6 [ label="1'0" ];
v7 [ label="1'1" ];
c32 [ shape=record, label="{{<p26> A|<p27> B|<p28> S}|$8\n$mux|{<p29> Y}}" ];
x8 [ shape=record, style=rounded, label="<s0> 0:0 - 15:15 " ];
c32:p29:e -> x8:w [arrowhead=odiamond, arrowtail=odiamond, dir=both, color="black", label=""];
x9 [ shape=record, style=rounded, label="<s14> 15x 15:15 - 14:0 " ];
x10 [ shape=record, style=rounded, label="<s0> 14:0 - 14:0 " ];
x9:e -> x10:w [arrowhead=odiamond, arrowtail=odiamond, dir=both, color="black", style="setlinewidth(3)", label=""];
c31:p29:e -> c23:p20:w [color="black", style="setlinewidth(3)", label=""];
c22:p21:e -> n10:w [color="black", style="setlinewidth(3)", label=""];
n11:e -> c31:p27:w [color="black", style="setlinewidth(3)", label=""];
n12:e -> c30:p27:w [color="black", style="setlinewidth(3)", label=""];
n13:e -> c30:p28:w [color="black", label=""];
n13:e -> c31:p28:w [color="black", label=""];
n13:e -> c32:p28:w [color="black", label=""];
c30:p29:e -> c24:p20:w [color="black", style="setlinewidth(3)", label=""];
n3 [ shape=point ];
x10:s0:e -> n3:w [color="black", style="setlinewidth(3)", label=""];
x8:s0:e -> n3:w [color="black", style="setlinewidth(3)", label=""];
n3:e -> x3:s15:w [color="black", style="setlinewidth(3)", label=""];
n3:e -> x9:s14:w [color="black", style="setlinewidth(3)", label=""];
c18:p17:e -> c22:p20:w [color="black", style="setlinewidth(3)", label=""];
c23:p21:e -> c19:p14:w [color="black", style="setlinewidth(3)", label=""];
c24:p21:e -> c19:p17:w [color="black", style="setlinewidth(3)", label=""];
c25:p21:e -> c19:p16:w [color="black", style="setlinewidth(3)", label=""];
n8:e -> c22:p15:w [color="black", label=""];
n8:e -> c23:p15:w [color="black", label=""];
n8:e -> c24:p15:w [color="black", label=""];
n8:e -> c25:p15:w [color="black", label=""];
n9:e -> c18:p14:w [color="black", style="setlinewidth(3)", label=""];
v0:e -> c18:p15:w [color="black", label=""];
v1:e -> c18:p16:w [color="black", label=""];
v2:e -> c19:p15:w [color="black", label=""];
v4:e -> c30:p26:w [color="black", style="setlinewidth(3)", label=""];
v5:e -> c31:p26:w [color="black", style="setlinewidth(3)", label=""];
v6:e -> c32:p26:w [color="black", label=""];
