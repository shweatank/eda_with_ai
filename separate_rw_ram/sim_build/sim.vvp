:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x556895bfedc0 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x556895bfef70 .scope module, "ram" "ram" 3 1;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "write_enable";
    .port_info 2 /INPUT 8 "write_address";
    .port_info 3 /INPUT 8 "read_address";
    .port_info 4 /INPUT 16 "write_data";
    .port_info 5 /OUTPUT 16 "read_data";
o0x7fba0489d018 .functor BUFZ 1, C4<z>; HiZ drive
v0x556895c25430_0 .net "clk", 0 0, o0x7fba0489d018;  0 drivers
v0x556895c47ee0 .array "memory", 255 0, 15 0;
o0x7fba0489d048 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x556895c47fa0_0 .net "read_address", 7 0, o0x7fba0489d048;  0 drivers
v0x556895c48060_0 .var "read_data", 15 0;
o0x7fba0489d0a8 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x556895c48140_0 .net "write_address", 7 0, o0x7fba0489d0a8;  0 drivers
o0x7fba0489d0d8 .functor BUFZ 16, C4<zzzzzzzzzzzzzzzz>; HiZ drive
v0x556895c48270_0 .net "write_data", 15 0, o0x7fba0489d0d8;  0 drivers
o0x7fba0489d108 .functor BUFZ 1, C4<z>; HiZ drive
v0x556895c48350_0 .net "write_enable", 0 0, o0x7fba0489d108;  0 drivers
E_0x556895c23390 .event posedge, v0x556895c25430_0;
    .scope S_0x556895bfef70;
T_0 ;
    %wait E_0x556895c23390;
    %load/vec4 v0x556895c48350_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %load/vec4 v0x556895c48270_0;
    %load/vec4 v0x556895c48140_0;
    %pad/u 10;
    %ix/vec4 3;
    %ix/load 4, 0, 0; Constant delay
    %assign/vec4/a/d v0x556895c47ee0, 0, 4;
T_0.0 ;
    %load/vec4 v0x556895c47fa0_0;
    %pad/u 10;
    %ix/vec4 4;
    %load/vec4a v0x556895c47ee0, 4;
    %assign/vec4 v0x556895c48060_0, 0;
    %jmp T_0;
    .thread T_0;
