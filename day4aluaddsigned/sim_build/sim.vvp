#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x563fcda3bdc0 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x563fcda3bf50 .scope module, "adder_signed" "adder_signed" 3 2;
 .timescale -9 -12;
    .port_info 0 /INPUT 8 "A";
    .port_info 1 /INPUT 8 "B";
    .port_info 2 /OUTPUT 8 "y";
o0x7f7cbc657018 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x563fcda4d7e0_0 .net/s "A", 7 0, o0x7f7cbc657018;  0 drivers
o0x7f7cbc657048 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x563fcda4dbd0_0 .net/s "B", 7 0, o0x7f7cbc657048;  0 drivers
v0x563fcda83ef0_0 .net/s "y", 7 0, L_0x563fcda84030;  1 drivers
L_0x563fcda84030 .arith/sum 8, o0x7f7cbc657018, o0x7f7cbc657048;
    .scope S_0x563fcda3bf50;
T_0 ;
    %vpi_call/w 3 9 "$dumpfile", "adder_signed.vcd" {0 0 0};
    %vpi_call/w 3 10 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x563fcda3bf50 {0 0 0};
    %end;
    .thread T_0;
