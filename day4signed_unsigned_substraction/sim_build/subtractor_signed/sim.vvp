#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x55a62a4728c0 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x55a62a472a50 .scope module, "subtractor_signed" "subtractor_signed" 3 21;
 .timescale -9 -12;
    .port_info 0 /INPUT 8 "A";
    .port_info 1 /INPUT 8 "B";
    .port_info 2 /OUTPUT 8 "y";
o0x7fbc0b2e8018 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x55a62a448bd0_0 .net/s "A", 7 0, o0x7fbc0b2e8018;  0 drivers
o0x7fbc0b2e8048 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x55a62a482cb0_0 .net/s "B", 7 0, o0x7fbc0b2e8048;  0 drivers
v0x55a62a482d90_0 .net/s "y", 7 0, L_0x55a62a482ed0;  1 drivers
L_0x55a62a482ed0 .arith/sub 8, o0x7fbc0b2e8018, o0x7fbc0b2e8048;
    .scope S_0x55a62a472a50;
T_0 ;
    %vpi_call/w 3 29 "$dumpfile", "subtractor_signed.vcd" {0 0 0};
    %vpi_call/w 3 30 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x55a62a472a50 {0 0 0};
    %end;
    .thread T_0;
