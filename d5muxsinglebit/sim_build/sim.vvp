#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x55cb13d33ed0 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x55cb13d34060 .scope module, "mux2" "mux2" 3 4;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /INPUT 1 "sel";
    .port_info 3 /OUTPUT 1 "y";
o0x7fe38b39f018 .functor BUFZ 1, C4<z>; HiZ drive
v0x55cb13d1fbd0_0 .net "a", 0 0, o0x7fe38b39f018;  0 drivers
o0x7fe38b39f048 .functor BUFZ 1, C4<z>; HiZ drive
v0x55cb13d55b40_0 .net "b", 0 0, o0x7fe38b39f048;  0 drivers
o0x7fe38b39f078 .functor BUFZ 1, C4<z>; HiZ drive
v0x55cb13d55c00_0 .net "sel", 0 0, o0x7fe38b39f078;  0 drivers
v0x55cb13d55cd0_0 .net "y", 0 0, L_0x55cb13d55e40;  1 drivers
L_0x55cb13d55e40 .functor MUXZ 1, o0x7fe38b39f018, o0x7fe38b39f048, o0x7fe38b39f078, C4<>;
    .scope S_0x55cb13d34060;
T_0 ;
    %vpi_call/w 3 13 "$dumpfile", "mux_singlebit.vcd" {0 0 0};
    %vpi_call/w 3 14 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x55cb13d34060 {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "/home/mirafra/vlsi/eda_with_ai/d5muxsinglebit/single_bit_mux.sv";
