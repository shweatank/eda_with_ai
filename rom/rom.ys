# ============================================================
# YOSYS SYNTHESIS SCRIPT
# ============================================================

# Read SystemVerilog RTL
read_verilog -sv rom.sv

# Set top module
hierarchy -top rom

# Convert behavioral processes
proc

# Optimize
opt

# Technology mapping
techmap

# Optimize
opt

# ABC logic optimization
abc

# Final optimization
opt

# Show synthesis statistics
stat

# Write synthesized netlist
write_verilog -noattr netlist/rom_netlist.v