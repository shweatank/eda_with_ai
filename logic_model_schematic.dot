digraph "logic_model" {
label="logic_model";
rankdir="LR";
remincross=true;
n2 [ shape=octagon, label="y", color="black", fontcolor="black"];
n3 [ shape=octagon, label="c", color="black", fontcolor="black"];
n4 [ shape=octagon, label="b", color="black", fontcolor="black"];
n5 [ shape=octagon, label="a", color="black", fontcolor="black"];
c9 [ shape=record, label="{{<p6> A|<p7> B}|$78\n$_AND_|{<p8> Y}}",  ];
c10 [ shape=record, label="{{<p6> A|<p7> B}|$79\n$_OR_|{<p8> Y}}",  ];
c9:p8:e -> c10:p7:w [color="black", fontcolor="black", label=""];
c10:p8:e -> n2:w [color="black", fontcolor="black", label=""];
n3:e -> c10:p6:w [color="black", fontcolor="black", label=""];
n4:e -> c9:p7:w [color="black", fontcolor="black", label=""];
n5:e -> c9:p6:w [color="black", fontcolor="black", label=""];
}
