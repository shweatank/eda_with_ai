#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x563e89a08dc0 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x563e89a08f50 .scope module, "and_gate" "and_gate" 3 1;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
o0x7fe2d577f018 .functor BUFZ 1, C4<z>; HiZ drive
o0x7fe2d577f048 .functor BUFZ 1, C4<z>; HiZ drive
L_0x563e89a50570 .functor AND 1, o0x7fe2d577f018, o0x7fe2d577f048, C4<1>, C4<1>;
v0x563e89a1abd0_0 .net "a", 0 0, o0x7fe2d577f018;  0 drivers
v0x563e89a50390_0 .net "b", 0 0, o0x7fe2d577f048;  0 drivers
v0x563e89a50450_0 .net "y", 0 0, L_0x563e89a50570;  1 drivers
    .scope S_0x563e89a08f50;
T_0 ;
    %vpi_call/w 3 10 "$dumpfile", "dump.vcd" {0 0 0};
    %vpi_call/w 3 11 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x563e89a08f50 {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "/home/mirafra/vlsi/design_and.sv";
