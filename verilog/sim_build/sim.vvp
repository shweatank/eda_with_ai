#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x556138c40540 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x556138c406d0 .scope module, "nand_gate" "nand_gate" 3 1;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
o0x7982acbcf048 .functor BUFZ 1, C4<z>; HiZ drive
o0x7982acbcf078 .functor BUFZ 1, C4<z>; HiZ drive
L_0x556138c882c0 .functor AND 1, o0x7982acbcf048, o0x7982acbcf078, C4<1>, C4<1>;
L_0x556138c883c0 .functor NOT 1, L_0x556138c882c0, C4<0>, C4<0>, C4<0>;
v0x556138c66a70_0 .net *"_ivl_0", 0 0, L_0x556138c882c0;  1 drivers
v0x556138c88020_0 .net "a", 0 0, o0x7982acbcf048;  0 drivers
v0x556138c880e0_0 .net "b", 0 0, o0x7982acbcf078;  0 drivers
v0x556138c88180_0 .net "y", 0 0, L_0x556138c883c0;  1 drivers
    .scope S_0x556138c406d0;
T_0 ;
    %vpi_call/w 3 9 "$dumpfile", "nand_gate.vcd" {0 0 0};
    %vpi_call/w 3 10 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x556138c406d0 {0 0 0};
    %end;
    .thread T_0;
