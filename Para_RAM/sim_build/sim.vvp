#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5c28704c0b70 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x5c287049a490 .scope module, "para_ram" "para_ram" 3 1;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "write_enable";
    .port_info 2 /INPUT 8 "address";
    .port_info 3 /INPUT 8 "write_data";
    .port_info 4 /OUTPUT 8 "read_data";
P_0x5c28704c0170 .param/l "ADDR_WIDTH" 0 3 2, +C4<00000000000000000000000000001000>;
P_0x5c28704c01b0 .param/l "DATA_WIDTH" 0 3 3, +C4<00000000000000000000000000001000>;
o0x70219feb7018 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x5c287049a740_0 .net "address", 7 0, o0x70219feb7018;  0 drivers
o0x70219feb7048 .functor BUFZ 1, C4<z>; HiZ drive
v0x5c28704e4b80_0 .net "clk", 0 0, o0x70219feb7048;  0 drivers
v0x5c28704e4c40 .array "memory", 255 0, 7 0;
v0x5c28704e4d10_0 .var "read_data", 7 0;
o0x70219feb70a8 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x5c28704e4df0_0 .net "write_data", 7 0, o0x70219feb70a8;  0 drivers
o0x70219feb70d8 .functor BUFZ 1, C4<z>; HiZ drive
v0x5c28704e4f20_0 .net "write_enable", 0 0, o0x70219feb70d8;  0 drivers
E_0x5c28704d4650 .event posedge, v0x5c28704e4b80_0;
    .scope S_0x5c287049a490;
T_0 ;
    %wait E_0x5c28704d4650;
    %load/vec4 v0x5c28704e4f20_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %load/vec4 v0x5c28704e4df0_0;
    %load/vec4 v0x5c287049a740_0;
    %pad/u 10;
    %ix/vec4 3;
    %ix/load 4, 0, 0; Constant delay
    %assign/vec4/a/d v0x5c28704e4c40, 0, 4;
T_0.0 ;
    %load/vec4 v0x5c287049a740_0;
    %pad/u 10;
    %ix/vec4 4;
    %load/vec4a v0x5c28704e4c40, 4;
    %assign/vec4 v0x5c28704e4d10_0, 0;
    %jmp T_0;
    .thread T_0;
    .scope S_0x5c287049a490;
T_1 ;
    %vpi_call/w 3 20 "$dumpfile", "para_ram.vcd" {0 0 0};
    %vpi_call/w 3 21 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5c287049a490 {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
