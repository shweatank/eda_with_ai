S_0x562599b2ad90 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x562599b2af20 .scope module, "mux_if" "mux_if" 3 4;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /INPUT 1 "sel";
    .port_info 3 /OUTPUT 1 "y";
o0x7fdaf6c93018 .functor BUFZ 1, C4<z>; HiZ drive
v0x562599b3c7e0_0 .net "a", 0 0, o0x7fdaf6c93018;  0 drivers
o0x7fdaf6c93048 .functor BUFZ 1, C4<z>; HiZ drive
v0x562599b3cbd0_0 .net "b", 0 0, o0x7fdaf6c93048;  0 drivers
o0x7fdaf6c93078 .functor BUFZ 1, C4<z>; HiZ drive
v0x562599b732c0_0 .net "sel", 0 0, o0x7fdaf6c93078;  0 drivers
v0x562599b73360_0 .var "y", 0 0;
E_0x562599b2b400 .event edge, v0x562599b732c0_0, v0x562599b3c7e0_0, v0x562599b3cbd0_0;
    .scope S_0x562599b2af20;
T_0 ;
    %wait E_0x562599b2b400;
    %load/vec4 v0x562599b732c0_0;
    %cmpi/e 0, 0, 1;
    %jmp/0xz  T_0.0, 4;
    %load/vec4 v0x562599b3c7e0_0;
    %store/vec4 v0x562599b73360_0, 0, 1;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x562599b3cbd0_0;
    %store/vec4 v0x562599b73360_0, 0, 1;
T_0.1 ;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x562599b2af20;
T_1 ;
    %vpi_call/w 3 18 "$dumpfile", "mux_if.vcd" {0 0 0};
    %vpi_call/w 3 19 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x562599b2af20 {0 0 0};
    %end;
    .thread T_1;
