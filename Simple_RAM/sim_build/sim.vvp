#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5602529d7d90 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x5602529d7f40 .scope module, "simple_ram" "simple_ram" 3 1;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "write_enable";
    .port_info 2 /INPUT 8 "address";
    .port_info 3 /INPUT 8 "write_data";
    .port_info 4 /OUTPUT 8 "read_data";
o0x7f38d0667018 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x5602529e97e0_0 .net "address", 7 0, o0x7f38d0667018;  0 drivers
o0x7f38d0667048 .functor BUFZ 1, C4<z>; HiZ drive
v0x5602529e9bd0_0 .net "clk", 0 0, o0x7f38d0667048;  0 drivers
v0x560252a20ae0 .array "memory", 255 0, 7 0;
v0x560252a20bb0_0 .var "read_data", 7 0;
o0x7f38d06670a8 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x560252a20c90_0 .net "write_data", 7 0, o0x7f38d06670a8;  0 drivers
o0x7f38d06670d8 .functor BUFZ 1, C4<z>; HiZ drive
v0x560252a20dc0_0 .net "write_enable", 0 0, o0x7f38d06670d8;  0 drivers
E_0x5602529d8400 .event posedge, v0x5602529e9bd0_0;
    .scope S_0x5602529d7f40;
T_0 ;
    %wait E_0x5602529d8400;
    %load/vec4 v0x560252a20dc0_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %load/vec4 v0x560252a20c90_0;
    %load/vec4 v0x5602529e97e0_0;
    %pad/u 10;
    %ix/vec4 3;
    %ix/load 4, 0, 0; Constant delay
    %assign/vec4/a/d v0x560252a20ae0, 0, 4;
T_0.0 ;
    %load/vec4 v0x5602529e97e0_0;
    %pad/u 10;
    %ix/vec4 4;
    %load/vec4a v0x560252a20ae0, 4;
    %assign/vec4 v0x560252a20bb0_0, 0;
    %jmp T_0;
    .thread T_0;
