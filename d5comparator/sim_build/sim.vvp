#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x55d425b0ed90 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x55d425b0ef20 .scope module, "comparator" "comparator" 3 2;
 .timescale -9 -12;
    .port_info 0 /INPUT 8 "a";
    .port_info 1 /INPUT 8 "b";
    .port_info 2 /OUTPUT 1 "equal";
    .port_info 3 /OUTPUT 1 "greater";
    .port_info 4 /OUTPUT 1 "less";
o0x7f27d308f018 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x55d425b0f0b0_0 .net "a", 7 0, o0x7f27d308f018;  0 drivers
o0x7f27d308f048 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x55d425b57ce0_0 .net "b", 7 0, o0x7f27d308f048;  0 drivers
v0x55d425b57dc0_0 .net "equal", 0 0, L_0x55d425b580d0;  1 drivers
v0x55d425b57e60_0 .net "greater", 0 0, L_0x55d425b581d0;  1 drivers
v0x55d425b57f20_0 .net "less", 0 0, L_0x55d425b58340;  1 drivers
L_0x55d425b580d0 .cmp/eq 8, o0x7f27d308f018, o0x7f27d308f048;
L_0x55d425b581d0 .cmp/gt 8, o0x7f27d308f018, o0x7f27d308f048;
L_0x55d425b58340 .cmp/gt 8, o0x7f27d308f048, o0x7f27d308f018;
    .scope S_0x55d425b0ef20;
T_0 ;
    %vpi_call/w 3 14 "$dumpfile", "comparator.vcd" {0 0 0};
    %vpi_call/w 3 15 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x55d425b0ef20 {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "/home/mirafra/vlsi/eda_with_ai/d5comparator/comparator.sv";
