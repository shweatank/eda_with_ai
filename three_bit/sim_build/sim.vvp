#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x55d82dfa7d90 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x55d82dfa7f20 .scope module, "combo_gate" "combo_gate" 3 1;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /INPUT 1 "c";
    .port_info 3 /OUTPUT 1 "y";
o0x7fe69fca5048 .functor BUFZ 1, C4<z>; HiZ drive
o0x7fe69fca5078 .functor BUFZ 1, C4<z>; HiZ drive
L_0x55d82dfefe40 .functor AND 1, o0x7fe69fca5048, o0x7fe69fca5078, C4<1>, C4<1>;
o0x7fe69fca50a8 .functor BUFZ 1, C4<z>; HiZ drive
L_0x55d82dfeff30 .functor OR 1, L_0x55d82dfefe40, o0x7fe69fca50a8, C4<0>, C4<0>;
v0x55d82dfce150_0 .net *"_ivl_0", 0 0, L_0x55d82dfefe40;  1 drivers
v0x55d82dfefa60_0 .net "a", 0 0, o0x7fe69fca5048;  0 drivers
v0x55d82dfefb20_0 .net "b", 0 0, o0x7fe69fca5078;  0 drivers
v0x55d82dfefbf0_0 .net "c", 0 0, o0x7fe69fca50a8;  0 drivers
v0x55d82dfefcb0_0 .net "y", 0 0, L_0x55d82dfeff30;  1 drivers
    .scope S_0x55d82dfa7f20;
T_0 ;
    %vpi_call/w 3 11 "$dumpfile", "dump_combo.vcd" {0 0 0};
    %vpi_call/w 3 12 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x55d82dfa7f20 {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "/home/mirafra/vlsi/three_bit/design_combo.sv";
