#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5631977efdc0 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x5631977eff50 .scope module, "adder" "adder" 3 2;
 .timescale -9 -12;
    .port_info 0 /INPUT 8 "A";
    .port_info 1 /INPUT 8 "B";
    .port_info 2 /OUTPUT 8 "y";
o0x7f1aaf098018 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x5631978017e0_0 .net "A", 7 0, o0x7f1aaf098018;  0 drivers
o0x7f1aaf098048 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x563197801bd0_0 .net "B", 7 0, o0x7f1aaf098048;  0 drivers
v0x563197837d10_0 .net "y", 7 0, L_0x563197837e50;  1 drivers
L_0x563197837e50 .arith/sum 8, o0x7f1aaf098018, o0x7f1aaf098048;
    .scope S_0x5631977eff50;
T_0 ;
    %vpi_call/w 3 9 "$dumpfile", "adder.vcd" {0 0 0};
    %vpi_call/w 3 10 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5631977eff50 {0 0 0};
    %end;
    .thread T_0;
