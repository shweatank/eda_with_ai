# ===================================================================
# AI-Powered RTL Verification & Debugging Platform
# Copy this file to `.env` and fill in your own credentials.
# NEVER commit the real `.env`.
# ===================================================================

# ---- Neo4j AuraDB (https://console.neo4j.io) ----
# The connection URI is shown on your AuraDB instance card.
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
# For AuraDB the username is almost always literally "neo4j"
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password
# For AuraDB the database name is almost always literally "neo4j"
NEO4J_DATABASE=neo4j

# ---- Groq (https://console.groq.com/keys) ----
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# ---- local service endpoints (defaults are fine) ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
GRAPHQL_URL=http://localhost:8000/graphql

# ---- tool paths / limits ----
IVERILOG_BIN=iverilog
VVP_BIN=vvp
SIM_TIMEOUT_SECONDS=60
