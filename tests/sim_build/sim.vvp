#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5caca409b140 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x5caca40b0ce0 .scope module, "and_gate" "and_gate" 3 2;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
o0x7d131d19f018 .functor BUFZ 1, C4<z>; HiZ drive
o0x7d131d19f048 .functor BUFZ 1, C4<z>; HiZ drive
L_0x5caca40c1270 .functor AND 1, o0x7d131d19f018, o0x7d131d19f048, C4<1>, C4<1>;
v0x5caca40b0ec0_0 .net "a", 0 0, o0x7d131d19f018;  0 drivers
v0x5caca40c1090_0 .net "b", 0 0, o0x7d131d19f048;  0 drivers
v0x5caca40c1150_0 .net "y", 0 0, L_0x5caca40c1270;  1 drivers
    .scope S_0x5caca40b0ce0;
T_0 ;
    %vpi_call/w 3 10 "$dumpfile", "and_gate.vcd" {0 0 0};
    %vpi_call/w 3 11 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5caca40b0ce0 {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "/home/mirafra/verilog_projects/eda_with_ai/tests/rtl/basic_gates.sv";
