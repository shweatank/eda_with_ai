 .timescale -9 -12;
S_0x55daeeee1a30 .scope module, "multiplier_signed" "multiplier_signed" 3 22;
 .timescale -9 -12;
    .port_info 0 /INPUT 8 "A";
    .port_info 1 /INPUT 8 "B";
    .port_info 2 /OUTPUT 16 "product";
o0x7f35cd2b8018 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
