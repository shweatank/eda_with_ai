v0x55daeeef2410_0 .net/s *"_ivl_2", 15 0, L_0x55daeeef2770;  1 drivers
v0x55daeeef24f0_0 .net/s "product", 15 0, L_0x55daeeef2870;  1 drivers
L_0x55daeeef26a0 .extend/s 16, o0x7f35cd2b8018;
L_0x55daeeef2770 .extend/s 16, o0x7f35cd2b8048;
L_0x55daeeef2870 .arith/mult 16, L_0x55daeeef26a0, L_0x55daeeef2770;
    .scope S_0x55daeeee1a30;
T_0 ;
    %vpi_call/w 3 30 "$dumpfile", "multiplier_signed.vcd" {0 0 0};
