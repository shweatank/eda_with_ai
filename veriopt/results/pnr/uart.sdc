# Auto-generated by scripts/gen_sdc.py for 'uart'.
# Override by hand-writing constraints/uart.sdc.

set_units -time ns -capacitance pF

create_clock -name core_clk -period 10.0 [get_ports clk]
set_clock_uncertainty 0.25 [get_clocks core_clk]
set_clock_transition 0.15 [get_clocks core_clk]

set_input_delay -clock core_clk 2.0 [get_ports {data_in}]
set_output_delay -clock core_clk 2.0 [all_outputs]

set_driving_cell -lib_cell sky130_fd_sc_hd__buf_1 -pin X [get_ports {data_in}]
set_load 0.02 [all_outputs]
