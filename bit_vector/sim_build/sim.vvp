#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x570d3f92b510 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x570d3f92b6a0 .scope module, "div_signed" "div_signed" 3 1;
 .timescale -9 -12;
    .port_info 0 /INPUT 8 "a";
    .port_info 1 /INPUT 8 "b";
    .port_info 2 /OUTPUT 8 "quotient";
    .port_info 3 /OUTPUT 8 "remainder";
o0x78e267a8d018 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x570d3f951e20_0 .net/s "a", 7 0, o0x78e267a8d018;  0 drivers
o0x78e267a8d048 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x570d3f974090_0 .net/s "b", 7 0, o0x78e267a8d048;  0 drivers
v0x570d3f974170_0 .net/s "quotient", 7 0, L_0x570d3f9743f0;  1 drivers
v0x570d3f974260_0 .net/s "remainder", 7 0, L_0x570d3f9744f0;  1 drivers
L_0x570d3f9743f0 .arith/div.s 8, o0x78e267a8d018, o0x78e267a8d048;
L_0x570d3f9744f0 .arith/mod.s 8, o0x78e267a8d018, o0x78e267a8d048;
    .scope S_0x570d3f92b6a0;
T_0 ;
    %vpi_call/w 3 11 "$dumpfile", "div_signed.vcd" {0 0 0};
    %vpi_call/w 3 12 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x570d3f92b6a0 {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "/home/sam/git_folder/eda_with_ai/bit_vector/div_signed.sv";
