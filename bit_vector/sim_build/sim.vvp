#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5bcd456f0540 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x5bcd456f06d0 .scope module, "sub_signed" "sub_signed" 3 1;
 .timescale -9 -12;
    .port_info 0 /INPUT 8 "a";
    .port_info 1 /INPUT 8 "b";
    .port_info 2 /OUTPUT 8 "diff";
o0x74c5e7ab7018 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x5bcd45702430_0 .net/s "a", 7 0, o0x74c5e7ab7018;  0 drivers
o0x74c5e7ab7048 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x5bcd457384f0_0 .net/s "b", 7 0, o0x74c5e7ab7048;  0 drivers
v0x5bcd457385d0_0 .net/s "diff", 7 0, L_0x5bcd45738710;  1 drivers
L_0x5bcd45738710 .arith/sub 8, o0x74c5e7ab7018, o0x74c5e7ab7048;
    .scope S_0x5bcd456f06d0;
T_0 ;
    %vpi_call/w 3 9 "$dumpfile", "sub_signed.vcd" {0 0 0};
    %vpi_call/w 3 10 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5bcd456f06d0 {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "/home/sam/bit_vector/sub_signed.sv";
