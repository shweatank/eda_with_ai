#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x63a456b9f510 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x63a456b9f6a0 .scope module, "half_adder" "half_adder" 3 1;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "sum";
    .port_info 3 /OUTPUT 1 "carry";
o0x77cae76e6018 .functor BUFZ 1, C4<z>; HiZ drive
o0x77cae76e6048 .functor BUFZ 1, C4<z>; HiZ drive
L_0x63a456be79f0 .functor XOR 1, o0x77cae76e6018, o0x77cae76e6048, C4<0>, C4<0>;
L_0x63a456be7ae0 .functor AND 1, o0x77cae76e6018, o0x77cae76e6048, C4<1>, C4<1>;
v0x63a456bc5d70_0 .net "a", 0 0, o0x77cae76e6018;  0 drivers
v0x63a456be76f0_0 .net "b", 0 0, o0x77cae76e6048;  0 drivers
v0x63a456be77b0_0 .net "carry", 0 0, L_0x63a456be7ae0;  1 drivers
v0x63a456be7880_0 .net "sum", 0 0, L_0x63a456be79f0;  1 drivers
    .scope S_0x63a456b9f6a0;
T_0 ;
    %vpi_call/w 3 11 "$dumpfile", "half_adder.vcd" {0 0 0};
    %vpi_call/w 3 12 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x63a456b9f6a0 {0 0 0};
    %end;
    .thread T_0;
