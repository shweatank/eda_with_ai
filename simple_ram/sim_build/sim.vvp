o0x7a6c5c172048 .functor BUFZ 1, C4<z>; HiZ drive
v0x64b0ccf0bcd0_0 .net "clk", 0 0, o0x7a6c5c172048;  0 drivers
v0x64b0ccf0bd90 .array "memory", 65535 0, 15 0;
v0x64b0ccf0be60_0 .var "read_data", 15 0;
o0x7a6c5c1720a8 .functor BUFZ 16, C4<zzzzzzzzzzzzzzzz>; HiZ drive
v0x64b0ccf0bf40_0 .net "write_data", 15 0, o0x7a6c5c1720a8;  0 drivers
o0x7a6c5c1720d8 .functor BUFZ 1, C4<z>; HiZ drive
v0x64b0ccf0c070_0 .net "write_enable", 0 0, o0x7a6c5c1720d8;  0 drivers
E_0x64b0ccefbf00 .event posedge, v0x64b0ccf0bcd0_0;
    .scope S_0x64b0ccec2650;
T_0 ;
    %wait E_0x64b0ccefbf00;
    %load/vec4 v0x64b0ccf0c070_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %load/vec4 v0x64b0ccf0bf40_0;
    %load/vec4 v0x64b0ccec2800_0;
    %pad/u 18;
    %ix/vec4 3;
    %ix/load 4, 0, 0; Constant delay
    %assign/vec4/a/d v0x64b0ccf0bd90, 0, 4;
T_0.0 ;
    %load/vec4 v0x64b0ccec2800_0;
    %pad/u 18;
    %ix/vec4 4;
    %load/vec4a v0x64b0ccf0bd90, 4;
    %assign/vec4 v0x64b0ccf0be60_0, 0;
    %jmp T_0;
    .thread T_0;
    .scope S_0x64b0ccec2650;
T_1 ;
    %vpi_call/w 3 38 "$dumpfile", "waves/rtl.vcd" {0 0 0};
    %vpi_call/w 3 39 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x64b0ccec2650 {0 0 0};
