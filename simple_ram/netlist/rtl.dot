digraph "simple_ram" {
label="simple_ram";
rankdir="LR";
remincross=true;
n5 [ shape=octagon, label="address", color="black", fontcolor="black" ];
n6 [ shape=octagon, label="clk", color="black", fontcolor="black" ];
n7 [ shape=octagon, label="read_data", color="black", fontcolor="black" ];
n8 [ shape=octagon, label="write_data", color="black", fontcolor="black" ];
n9 [ shape=octagon, label="write_enable", color="black", fontcolor="black" ];
c14 [ shape=record, label="{{<p10> ADDR|<p11> CLK|<p12> DATA|<p13> EN}|$23\n$memwr_v2|{}}",  ];
x0 [ shape=record, style=rounded, label="<s15> 16x 15:15 - 15:0 ", color="black", fontcolor="black" ];
x0:e -> c14:p13:w [arrowhead=odiamond, arrowtail=odiamond, dir=both, color="black", fontcolor="black", style="setlinewidth(3)", label=""];
v1 [ label="1'x" ];
v2 [ label="1'x" ];
c15 [ shape=record, label="{{<p10> ADDR|<p11> CLK|<p13> EN}|$9\n$memrd|{<p12> DATA}}",  ];
c18 [ shape=record, label="{{<p11> CLK|<p16> D}|$19\n$dff|{<p17> Q}}",  ];
v3 [ label="1'0" ];
v4 [ label="1'1" ];
c23 [ shape=record, label="{{<p19> A|<p20> B|<p21> S}|$11\n$mux|{<p22> Y}}",  ];
x5 [ shape=record, style=rounded, label="<s0> 0:0 - 15:15 ", color="black", fontcolor="black" ];
c23:p22:e -> x5:w [arrowhead=odiamond, arrowtail=odiamond, dir=both, color="black", fontcolor="black", label=""];
v6 [ label="16'x" ];
c24 [ shape=record, label="{{<p19> A|<p20> B|<p21> S}|$14\n$mux|{<p22> Y}}",  ];
v7 [ label="16'x" ];
c25 [ shape=record, label="{{<p19> A|<p20> B|<p21> S}|$17\n$mux|{<p22> Y}}",  ];
x8 [ shape=record, style=rounded, label="<s14> 15x 15:15 - 14:0 ", color="black", fontcolor="black" ];
x9 [ shape=record, style=rounded, label="<s0> 14:0 - 14:0 ", color="black", fontcolor="black" ];
x8:e -> x9:w [arrowhead=odiamond, arrowtail=odiamond, dir=both, color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c25:p22:e -> c14:p10:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c24:p22:e -> c14:p12:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n3 [ shape=point ];
x5:s0:e -> n3:w [color="black", fontcolor="black", label=""];
x9:s0:e -> n3:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n3:e -> x0:s15:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n3:e -> x8:s14:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c15:p12:e -> c18:p16:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n5:e -> c15:p10:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n5:e -> c25:p20:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n6:e -> c14:p11:w [color="black", fontcolor="black", label=""];
n6:e -> c18:p11:w [color="black", fontcolor="black", label=""];
c18:p17:e -> n7:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n8:e -> c24:p20:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n9:e -> c23:p21:w [color="black", fontcolor="black", label=""];
n9:e -> c24:p21:w [color="black", fontcolor="black", label=""];
n9:e -> c25:p21:w [color="black", fontcolor="black", label=""];
v1:e -> c15:p11:w [color="black", fontcolor="black", label=""];
v2:e -> c15:p13:w [color="black", fontcolor="black", label=""];
v3:e -> c23:p19:w [color="black", fontcolor="black", label=""];
v4:e -> c23:p20:w [color="black", fontcolor="black", label=""];
v6:e -> c24:p19:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
v7:e -> c25:p19:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
}
