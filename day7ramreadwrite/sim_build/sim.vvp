#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x557136d2b330 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x557136d2b4e0 .scope module, "ram" "ram" 3 1;
 .timescale -9 -12;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "write_enable";
    .port_info 2 /INPUT 8 "write_address";
    .port_info 3 /INPUT 8 "read_address";
    .port_info 4 /INPUT 16 "write_data";
    .port_info 5 /OUTPUT 16 "read_data";
o0x7f76806e8018 .functor BUFZ 1, C4<z>; HiZ drive
v0x557136d2b690_0 .net "clk", 0 0, o0x7f76806e8018;  0 drivers
v0x557136d4e950 .array "memory", 255 0, 15 0;
o0x7f76806e8048 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x557136d4ea10_0 .net "read_address", 7 0, o0x7f76806e8048;  0 drivers
v0x557136d4ead0_0 .var "read_data", 15 0;
o0x7f76806e80a8 .functor BUFZ 8, C4<zzzzzzzz>; HiZ drive
v0x557136d4ebb0_0 .net "write_address", 7 0, o0x7f76806e80a8;  0 drivers
o0x7f76806e80d8 .functor BUFZ 16, C4<zzzzzzzzzzzzzzzz>; HiZ drive
v0x557136d4ec90_0 .net "write_data", 15 0, o0x7f76806e80d8;  0 drivers
o0x7f76806e8108 .functor BUFZ 1, C4<z>; HiZ drive
v0x557136d4ed70_0 .net "write_enable", 0 0, o0x7f76806e8108;  0 drivers
E_0x557136d29390 .event posedge, v0x557136d2b690_0;
    .scope S_0x557136d2b4e0;
T_0 ;
    %vpi_call/w 3 13 "$dumpfile", "ram.vcd" {0 0 0};
    %vpi_call/w 3 14 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x557136d2b4e0 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x557136d2b4e0;
T_1 ;
    %wait E_0x557136d29390;
    %load/vec4 v0x557136d4ed70_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_1.0, 8;
    %load/vec4 v0x557136d4ec90_0;
    %load/vec4 v0x557136d4ebb0_0;
    %pad/u 10;
    %ix/vec4 3;
    %ix/load 4, 0, 0; Constant delay
    %assign/vec4/a/d v0x557136d4e950, 0, 4;
T_1.0 ;
    %load/vec4 v0x557136d4ea10_0;
    %pad/u 10;
    %ix/vec4 4;
    %load/vec4a v0x557136d4e950, 4;
    %assign/vec4 v0x557136d4ead0_0, 0;
    %jmp T_1;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 4;
