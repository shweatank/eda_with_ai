#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x55569c0366f0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x55569c036880 .scope module, "tb_half_adder" "tb_half_adder" 3 17;
 .timescale 0 0;
v0x55569c04cc20_0 .var "a", 0 0;
v0x55569c04cce0_0 .var "b", 0 0;
v0x55569c04cdb0_0 .net "carry", 0 0, L_0x55569c04d0e0;  1 drivers
v0x55569c04ceb0_0 .net "sum", 0 0, L_0x55569c04cf80;  1 drivers
S_0x55569c027470 .scope module, "uut" "half_adder" 3 22, 3 2 0, S_0x55569c036880;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "sum";
    .port_info 3 /OUTPUT 1 "carry";
L_0x55569c04cf80 .functor XOR 1, v0x55569c04cc20_0, v0x55569c04cce0_0, C4<0>, C4<0>;
L_0x55569c04d0e0 .functor AND 1, v0x55569c04cc20_0, v0x55569c04cce0_0, C4<1>, C4<1>;
v0x55569c0276c0_0 .net "a", 0 0, v0x55569c04cc20_0;  1 drivers
v0x55569c04c950_0 .net "b", 0 0, v0x55569c04cce0_0;  1 drivers
v0x55569c04ca10_0 .net "carry", 0 0, L_0x55569c04d0e0;  alias, 1 drivers
v0x55569c04cab0_0 .net "sum", 0 0, L_0x55569c04cf80;  alias, 1 drivers
    .scope S_0x55569c036880;
T_0 ;
    %vpi_call/w 3 30 "$dumpfile", "half_adder.vcd" {0 0 0};
    %vpi_call/w 3 31 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x55569c036880 {0 0 0};
    %vpi_call/w 3 33 "$display", "Time\011A B | Sum Carry" {0 0 0};
    %vpi_call/w 3 34 "$display", "-------------------" {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55569c04cc20_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55569c04cce0_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 38 "$display", "%0t\011%b %b |  %b     %b", $time, v0x55569c04cc20_0, v0x55569c04cce0_0, v0x55569c04ceb0_0, v0x55569c04cdb0_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55569c04cc20_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55569c04cce0_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 41 "$display", "%0t\011%b %b |  %b     %b", $time, v0x55569c04cc20_0, v0x55569c04cce0_0, v0x55569c04ceb0_0, v0x55569c04cdb0_0 {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55569c04cc20_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55569c04cce0_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 44 "$display", "%0t\011%b %b |  %b     %b", $time, v0x55569c04cc20_0, v0x55569c04cce0_0, v0x55569c04ceb0_0, v0x55569c04cdb0_0 {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55569c04cc20_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55569c04cce0_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 47 "$display", "%0t\011%b %b |  %b     %b", $time, v0x55569c04cc20_0, v0x55569c04cce0_0, v0x55569c04ceb0_0, v0x55569c04cdb0_0 {0 0 0};
    %vpi_call/w 3 49 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "half_adder.sv";
