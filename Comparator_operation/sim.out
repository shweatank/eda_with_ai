 .timescale 0 0;
    .port_info 0 /INPUT 2 "a";
    .port_info 1 /OUTPUT 4 "y";
v0x5643c5f39510_0 .net "a", 1 0, v0x5643c5f3a150_0;  1 drivers
v0x5643c5f39610_0 .var "y", 3 0;
E_0x5643c5f1aec0 .event edge, v0x5643c5f39510_0;
S_0x5643c5f39750 .scope module, "u_mux" "mux_if" 3 70, 3 22 0, S_0x5643c5f0d150;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /INPUT 1 "sel";
    .port_info 3 /OUTPUT 1 "y";
v0x5643c5f39950_0 .net "a", 0 0, v0x5643c5f3a2f0_0;  1 drivers
v0x5643c5f39a10_0 .net "b", 0 0, v0x5643c5f3a3c0_0;  1 drivers
