    %vpi_call/w 3 83 "$display", "\012=== Testing Mux (if-else) ===" {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5643c5f3a2f0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5643c5f3a3c0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5643c5f3a490_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 85 "$display", "sel=%b (a=%b, b=%b) -> y=%b", v0x5643c5f3a490_0, v0x5643c5f3a2f0_0, v0x5643c5f3a3c0_0, v0x5643c5f3a560_0 {0 0 0};
    %pushi/vec4 1, 0, 1;
