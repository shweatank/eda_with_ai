    %store/vec4 v0x5643c5f39610_0, 0, 4;
    %jmp T_0.5;
T_0.5 ;
    %pop/vec4 1;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x5643c5f39750;
T_1 ;
Ewait_1 .event/or E_0x5643c5f01ef0, E_0x0;
    %wait Ewait_1;
    %load/vec4 v0x5643c5f39ad0_0;
    %cmpi/e 0, 0, 1;
    %jmp/0xz  T_1.0, 4;
    %load/vec4 v0x5643c5f39950_0;
    %store/vec4 v0x5643c5f39b70_0, 0, 1;
