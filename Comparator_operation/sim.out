T_1.1 ;
    %jmp T_1;
    .thread T_1, $push;
    .scope S_0x5643c5f0d150;
T_2 ;
    %vpi_call/w 3 74 "$dumpfile", "combined.vcd" {0 0 0};
    %vpi_call/w 3 75 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5643c5f0d150 {0 0 0};
    %vpi_call/w 3 77 "$display", "=== Testing 2-to-4 Decoder ===" {0 0 0};
    %pushi/vec4 0, 0, 2;
    %store/vec4 v0x5643c5f3a150_0, 0, 2;
    %delay 10, 0;
    %vpi_call/w 3 78 "$display", "a=%b -> y=%b", v0x5643c5f3a150_0, v0x5643c5f3a220_0 {0 0 0};
    %pushi/vec4 1, 0, 2;
