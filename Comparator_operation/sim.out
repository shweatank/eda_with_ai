    .scope S_0x5643c5f392d0;
T_0 ;
Ewait_0 .event/or E_0x5643c5f1aec0, E_0x0;
    %wait Ewait_0;
    %load/vec4 v0x5643c5f39510_0;
    %dup/vec4;
